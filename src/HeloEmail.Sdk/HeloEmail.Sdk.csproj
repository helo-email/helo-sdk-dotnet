<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <RepositoryUrl>https://github.com/helo-email/helo-sdk-dotnet</RepositoryUrl>
        <PackageProjectUrl>https://github.com/helo-email/helo-sdk-dotnet</PackageProjectUrl>
        <Description>Helo (https://helohq.com) is an email API for developers and platforms.</Description>
        <PackageId>HeloEmail.Sdk</PackageId>
        <Authors>Helo Email</Authors>
        <Version>1.0.0-beta.1</Version>
        <Company>HELO EHLO LLC</Company>
        <Product>Helo</Product>
        <PackageTags>Helo;Email;SDK;Email API</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.jpg</PackageIcon>
        <Copyright>Copyright (c) HELO EHLO LLC 2026.</Copyright>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5"/>
        <PackageReference Include="System.Text.Json" Version="10.0.5"/>
    </ItemGroup>
    
    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="\"/>
        <None Include="../../icon.jpg" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
