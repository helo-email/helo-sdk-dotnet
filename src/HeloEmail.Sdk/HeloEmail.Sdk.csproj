<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace>HeloEmail.Sdk</RootNamespace>
        <RepositoryUrl>https://github.com/helo-email/helo-sdk-dotnet</RepositoryUrl>
        <PackageProjectUrl>https://api.helohq.com</PackageProjectUrl>
        <Description>Helo Email API (https://helohq.com)</Description>
        <PackageId>HeloEmail.Sdk</PackageId>
        <Authors>Helo Email</Authors>
        <Company>HELO EHLO LLC</Company>
        <Product>Helo</Product>
        <Copyright>Copyright (c) HELO EHLO LLC 2026.</Copyright>
        <Version>1.0.0-beta.10</Version>
        <PackageTags>Helo;SDK;API</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.jpg</PackageIcon>
        <IsPackable>true</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5"/>
        <PackageReference Include="System.Text.Json" Version="10.0.5"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="\"/>
        <None Include="../../icon.jpg" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
